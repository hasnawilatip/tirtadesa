<div class="page-head">
  <div>
    <h1>Kasbon Karyawan</h1>
    <p class="muted">Pinjaman karyawan yang dipotong bertahap dari gaji (maksimal 50% gaji bersih per bulan).</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-primary" type="button" data-modal-open="modalKasbon">+ Catat kasbon</button>
    <a class="btn btn-ghost" href="/karyawan">Karyawan</a>
  </div>
</div>

<div class="kpi-grid">
  <div class="card kpi kpi-red">
    <span class="kpi-icon">🧾</span>
    <span class="kpi-label">Sisa kasbon</span>
    <strong class="kpi-value"><%= rupiah(ringkas.sisa) %></strong>
    <span class="kpi-foot"><%= angka(ringkas.terbuka) %> kasbon terbuka</span>
  </div>
  <div class="card kpi kpi-blue">
    <span class="kpi-icon">📥</span>
    <span class="kpi-label">Total kasbon</span>
    <strong class="kpi-value"><%= rupiah(ringkas.total) %></strong>
    <span class="kpi-foot">Seluruh catatan</span>
  </div>
  <div class="card kpi kpi-teal">
    <span class="kpi-icon">✅</span>
    <span class="kpi-label">Sudah dibayar</span>
    <strong class="kpi-value"><%= rupiah(ringkas.dibayar) %></strong>
    <span class="kpi-foot">Cicilan + potongan gaji</span>
  </div>
</div>

<dialog class="modal" id="modalKasbon">
  <div class="modal-head">
    <div>
      <h2>Catat kasbon</h2>
      <span class="muted">Nomor kasbon dibuat otomatis.</span>
    </div>
    <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
  </div>
  <div class="modal-body">
    <form action="/kasbon" method="post">
      <div class="form-grid">
        <div class="field">
          <label>Karyawan</label>
          <select name="karyawan_id" required>
            <% karyawanList.forEach((k) => { %>
              <option value="<%= k.id %>"><%= k.nama %> · <%= k.nomor %><%= k.dusun ? ` · ${k.dusun}` : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Nomor</label>
          <input class="input" value="<%= nomorOtomatis %>" readonly>
        </div>
        <div class="field">
          <label>Tanggal</label>
          <input class="input" type="date" name="tanggal" value="<%= today %>" required>
        </div>
        <div class="field">
          <label>Jumlah (Rp)</label>
          <input class="input" type="number" step="1000" min="1" name="jumlah" required>
        </div>
        <div class="field span-2">
          <label>Keterangan</label>
          <input class="input" name="keterangan" placeholder="Mis. keperluan keluarga">
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Simpan kasbon</button>
        <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
      </div>
    </form>
  </div>
</dialog>

<section class="card">
  <form action="/kasbon" method="get" class="filters">
    <div class="field filter-cari">
      <label>Cari</label>
      <input class="input" name="q" value="<%= filters.q %>" placeholder="Nama karyawan / nomor kasbon">
    </div>
    <div class="field">
      <label>Status</label>
      <select name="status">
        <option value="">Semua status</option>
        <option value="terbuka" <%= filters.status === 'terbuka' ? 'selected' : '' %>>Terbuka</option>
        <option value="lunas" <%= filters.status === 'lunas' ? 'selected' : '' %>>Lunas</option>
        <option value="dibatalkan" <%= filters.status === 'dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
      </select>
    </div>
    <div class="field"><button class="btn btn-primary" type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" data-hasil="kasbon">
    <table class="table">
      <thead>
        <tr>
          <th>Nomor</th>
          <th>Karyawan</th>
          <th>Tanggal</th>
          <th class="num">Jumlah</th>
          <th class="num col-meter">Dibayar</th>
          <th class="num">Sisa</th>
          <th>Status</th>
          <th class="col-aksi"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="empty-cell">Belum ada kasbon pada filter ini.</td></tr>
        <% } %>
        <% rows.forEach((k) => { %>
          <tr>
            <td class="small"><strong><%= k.nomor %></strong></td>
            <td><%= k.karyawan %><div class="small muted"><%= k.nomor_karyawan %><%= k.dusun ? ` · ${k.dusun}` : '' %></div></td>
            <td class="small"><%= tanggal(k.tanggal) %></td>
            <td class="num"><%= rupiah(k.jumlah) %></td>
            <td class="num col-meter"><%= rupiah(k.dibayar) %></td>
            <td class="num"><strong class="<%= k.sisa ? 'text-danger' : 'text-success' %>"><%= rupiah(k.sisa) %></strong></td>
            <td><span class="badge <%= statusKelas(k.status) %>"><%= statusLabel[k.status] || k.status %></span></td>
            <td class="num col-aksi nowrap">
              <% if (k.status === 'terbuka') { %>
                <button class="link" type="button" data-modal-open="modalBayarKasbon<%= k.id %>">Bayar</button>
                <form action="/kasbon/<%= k.id %>/batal" method="post" onsubmit="return confirm('Batalkan kasbon ini?');">
                  <button class="link" type="submit">Batal</button>
                </form>
              <% } else { %>
                <span class="muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% rows.filter((k) => k.status === 'terbuka').forEach((k) => { %>
  <dialog class="modal modal-sm" id="modalBayarKasbon<%= k.id %>">
    <div class="modal-head">
      <div>
        <h2>Bayar kasbon</h2>
        <span class="muted"><%= k.nomor %> · <%= k.karyawan %> · sisa <%= rupiah(k.sisa) %></span>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
    </div>
    <div class="modal-body">
      <form action="/kasbon/<%= k.id %>/bayar" method="post">
        <div class="form-grid">
          <div class="field">
            <label>Tanggal bayar</label>
            <input class="input" type="date" name="tanggal" value="<%= today %>" required>
          </div>
          <div class="field">
            <label>Jumlah bayar (Rp)</label>
            <input class="input" type="number" step="1000" min="1" max="<%= Math.round(k.sisa) %>" name="jumlah" value="<%= Math.round(k.sisa) %>" required>
            <span class="small muted">Maksimal <%= rupiah(k.sisa) %>.</span>
          </div>
          <div class="field span-2">
            <label>Keterangan</label>
            <input class="input" name="keterangan" placeholder="Mis. cicilan tunai">
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Simpan pembayaran</button>
          <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
        </div>
      </form>
    </div>
  </dialog>
<% }) %>
