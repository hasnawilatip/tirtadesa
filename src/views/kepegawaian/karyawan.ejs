<div class="page-head">
  <div>
    <h1>Karyawan</h1>
    <p class="muted">Data karyawan pengelola, komponen gaji, dan sisa kasbon.</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-primary" type="button" data-modal-open="modalKaryawan">+ Tambah karyawan</button>
    <a class="btn btn-ghost" href="/absensi">Absensi</a>
    <a class="btn btn-ghost" href="/penggajian">Penggajian</a>
  </div>
</div>

<div class="kpi-grid">
  <div class="card kpi kpi-teal">
    <span class="kpi-icon">👷</span>
    <span class="kpi-label">Karyawan aktif</span>
    <strong class="kpi-value"><%= angka(ringkas.jumlah) %></strong>
    <span class="kpi-foot">Nonaktif: <%= angka(ringkas.nonaktif) %></span>
  </div>
  <div class="card kpi kpi-blue">
    <span class="kpi-icon">💰</span>
    <span class="kpi-label">Gaji pokok / bulan</span>
    <strong class="kpi-value"><%= rupiah(ringkas.pokok) %></strong>
    <span class="kpi-foot">Karyawan aktif</span>
  </div>
  <div class="card kpi kpi-amber">
    <span class="kpi-icon">➕</span>
    <span class="kpi-label">Tunjangan tetap</span>
    <strong class="kpi-value"><%= rupiah(ringkas.tunjangan) %></strong>
    <span class="kpi-foot">Per bulan</span>
  </div>
  <div class="card kpi kpi-red">
    <span class="kpi-icon">🧾</span>
    <span class="kpi-label">Kasbon terbuka</span>
    <strong class="kpi-value"><%= rupiah(ringkas.kasbon) %></strong>
    <span class="kpi-foot"><a class="link" href="/kasbon">Lihat kasbon</a></span>
  </div>
</div>

<dialog class="modal" id="modalKaryawan">
  <div class="modal-head">
    <div>
      <h2>Tambah karyawan</h2>
      <span class="muted">Karyawan tidak memerlukan akun login.</span>
    </div>
    <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
  </div>
  <div class="modal-body">
    <form action="/karyawan" method="post">
      <%- include('_form-karyawan', { karyawan: null, dusunList, nomor: nomorOtomatis }) %>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Simpan karyawan</button>
        <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
      </div>
    </form>
  </div>
</dialog>

<section class="card">
  <form action="/karyawan" method="get" class="filters">
    <div class="field filter-cari">
      <label>Cari karyawan</label>
      <input class="input" name="q" value="<%= filters.q %>" placeholder="Nama, nomor, jabatan, atau NIK">
    </div>
    <div class="field">
      <label>Status</label>
      <select name="status">
        <option value="">Semua status</option>
        <option value="aktif" <%= filters.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
        <option value="nonaktif" <%= filters.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
      </select>
    </div>
    <% if (dusunList.length > 1) { %>
      <div class="field">
        <label>Dusun</label>
        <select name="dusun">
          <option value="">Semua dusun</option>
          <% dusunList.forEach((d) => { %>
            <option value="<%= d.id %>" <%= String(filters.dusun) === String(d.id) ? 'selected' : '' %>><%= d.nama %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <div class="field"><button class="btn btn-primary" type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" data-hasil="karyawan">
    <table class="table">
      <thead>
        <tr>
          <th>Karyawan</th>
          <th class="col-dusun">Jabatan</th>
          <th class="col-sumur">Dusun</th>
          <th class="num">Gaji pokok</th>
          <th class="num col-meter">Tunjangan</th>
          <th class="num">Kasbon</th>
          <th>Status</th>
          <th class="col-aksi"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="empty-cell">Belum ada karyawan pada filter ini.</td></tr>
        <% } %>
        <% rows.forEach((k) => { %>
          <tr>
            <td>
              <strong><%= k.nama %></strong>
              <div class="small muted"><%= k.nomor %><%= k.telepon ? ` · ${k.telepon}` : '' %></div>
            </td>
            <td class="col-dusun"><%= k.jabatan || '—' %></td>
            <td class="col-sumur"><%= k.dusun || 'Tingkat desa' %></td>
            <td class="num"><%= rupiah(k.gaji_pokok) %></td>
            <td class="num col-meter"><%= rupiah(k.tunjangan_tetap) %></td>
            <td class="num"><%= rupiah(k.kasbon_sisa) %></td>
            <td><span class="badge <%= statusKelas(k.status) %>"><%= statusLabel[k.status] || k.status %></span></td>
            <td class="num col-aksi nowrap">
              <button class="link" type="button" data-modal-open="modalEdit<%= k.id %>">Edit</button>
              <a class="link" href="/absensi?bulan=<%= today.slice(0, 7) %>">Absensi</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% rows.forEach((k) => { %>
  <dialog class="modal" id="modalEdit<%= k.id %>">
    <div class="modal-head">
      <div>
        <h2>Edit karyawan</h2>
        <span class="muted"><%= k.nomor %> · <%= k.nama %></span>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
    </div>
    <div class="modal-body">
      <form action="/karyawan/<%= k.id %>" method="post">
        <%- include('_form-karyawan', { karyawan: k, dusunList, nomor: k.nomor }) %>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Simpan perubahan</button>
          <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
        </div>
      </form>
    </div>
  </dialog>
<% }) %>
