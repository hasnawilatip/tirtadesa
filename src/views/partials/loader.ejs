<%# Layar loading — dipakai layout utama dan halaman login %>
<div class="app-loader" id="appLoader" role="status" aria-live="polite">
  <div class="loader-inner">
    <div class="loader-mark" aria-hidden="true">
      <span class="loader-ring"></span>
      <span class="loader-ring loader-ring-2"></span>
      <span class="loader-drop"></span>
    </div>
    <div class="loader-text">
      <strong><%= pengaturan.nama_aplikasi %></strong>
      <span>Menyiapkan data sumur bor…</span>
    </div>
    <div class="loader-bar" aria-hidden="true"><i></i></div>
  </div>
</div>
