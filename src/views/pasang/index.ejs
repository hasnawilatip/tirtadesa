<div class="page-head">
  <div>
    <h1>Pendaftaran Pasang Baru</h1>
    <p class="muted">
      Petugas mendata calon pelanggan beserta hitungan pipa &amp; bahan, lalu admin
      memverifikasi, menyetujui, dan bahan disiapkan dari gudang.
    </p>
  </div>
  <% if (bolehDaftar) { %>
    <div class="page-actions">
      <button class="btn btn-primary" type="button" data-modal-open="modalPasang">+ Pendaftaran baru</button>
      <a class="btn btn-ghost" href="/bahan">Gudang bahan</a>
    </div>
  <% } else { %>
    <div class="page-actions"><a class="btn btn-ghost" href="/bahan">Gudang bahan</a></div>
  <% } %>
</div>

<% if (bolehDaftar) { %>
  <dialog class="modal modal-lg" id="modalPasang">
    <div class="modal-head">
      <div>
        <h2>Pendaftaran pasang baru</h2>
        <span class="muted">Nomor <strong><%= nomorOtomatis %></strong> dibuat otomatis · petugas mengisi data &amp; bahan, admin menyetujui</span>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
    </div>
    <div class="modal-body">
      <%- include('form', {
        dalamModal: true,
        row: null,
        rincian: [],
        dusunList,
        sumurList,
        golonganList,
        bahanList,
        nomorOtomatis,
      }) %>
    </div>
  </dialog>
<% } %>

<div class="kpi-grid">
  <div class="card kpi kpi-slate">
    <span class="kpi-icon">✎</span>
    <span class="kpi-label">Draf petugas</span>
    <strong class="kpi-value"><%= angka(ringkas.draf) %></strong>
    <span class="kpi-foot">Belum diajukan</span>
  </div>
  <div class="card kpi kpi-amber">
    <span class="kpi-icon">⏳</span>
    <span class="kpi-label">Menunggu persetujuan</span>
    <strong class="kpi-value"><%= angka(ringkas.diajukan) %></strong>
    <span class="kpi-foot">Perlu diperiksa admin</span>
  </div>
  <div class="card kpi kpi-blue">
    <span class="kpi-icon">📦</span>
    <span class="kpi-label">Bahan disiapkan</span>
    <strong class="kpi-value"><%= angka(ringkas.disetujui) %></strong>
    <span class="kpi-foot">Stok sudah dikeluarkan</span>
  </div>
  <div class="card kpi kpi-teal">
    <span class="kpi-icon">✓</span>
    <span class="kpi-label">Sudah terpasang</span>
    <strong class="kpi-value"><%= angka(ringkas.terpasang) %></strong>
    <span class="kpi-foot">Sudah jadi pelanggan</span>
  </div>
</div>

<section class="card">
  <form action="/pasang" method="get" class="filters">
    <div class="field filter-cari">
      <label>Cari</label>
      <input class="input" name="q" value="<%= filters.q %>" placeholder="Nama, nomor pendaftaran, telepon, alamat">
    </div>
    <div class="field">
      <label>Status</label>
      <select name="status">
        <option value="">Semua status</option>
        <option value="draf" <%= filters.status === 'draf' ? 'selected' : '' %>>Draf</option>
        <option value="diajukan" <%= filters.status === 'diajukan' ? 'selected' : '' %>>Menunggu persetujuan</option>
        <option value="disetujui" <%= filters.status === 'disetujui' ? 'selected' : '' %>>Disetujui / bahan disiapkan</option>
        <option value="terpasang" <%= filters.status === 'terpasang' ? 'selected' : '' %>>Terpasang</option>
        <option value="ditolak" <%= filters.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
        <option value="dibatalkan" <%= filters.status === 'dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
      </select>
    </div>
    <% if (dusunList.length > 1) { %>
      <div class="field">
        <label>Dusun</label>
        <select name="dusun">
          <option value="">Semua dusun</option>
          <% dusunList.forEach((d) => { %>
            <option value="<%= d.id %>" <%= String(filters.dusun) === String(d.id) ? 'selected' : '' %>><%= d.nama %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <div class="field"><button class="btn btn-primary" type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" data-hasil="daftar">
    <table class="table">
      <thead>
        <tr>
          <th>Nomor</th>
          <th>Calon pelanggan</th>
          <th class="col-dusun">Dusun</th>
          <th class="col-sumur">Golongan</th>
          <th class="num col-meter">Pipa</th>
          <th class="num">Bahan</th>
          <th class="num col-golongan">Perkiraan biaya</th>
          <th>Status</th>
          <th class="col-aksi"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="9" class="empty-cell">Belum ada pendaftaran pada filter ini.</td></tr>
        <% } %>
        <% rows.forEach((p) => { %>
          <tr>
            <td>
              <a class="link" href="/pasang/<%= p.id %>"><strong><%= p.nomor %></strong></a>
              <div class="small muted"><%= tanggal(p.tanggal_survei) %></div>
            </td>
            <td>
              <%= p.nama %>
              <div class="small muted"><%= p.telepon || p.alamat || '-' %></div>
            </td>
            <td class="col-dusun"><%= p.dusun_nama %></td>
            <td class="col-sumur small"><%= p.golongan_nama || '-' %></td>
            <td class="num col-meter small">
              <%= p.panjang_pipa ? `${angka(p.panjang_pipa)} m` : '-' %>
              <div class="muted"><%= p.ukuran_pipa || '' %></div>
            </td>
            <td class="num small"><%= angka(p.jumlah_bahan) %> jenis</td>
            <td class="num col-golongan"><%= rupiah(p.total_biaya) %></td>
            <td><span class="badge <%= statusKelas(p.status) %>"><%= statusLabel[p.status] || p.status %></span></td>
            <td class="num col-aksi nowrap">
              <a class="link" href="/pasang/<%= p.id %>">Detail</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
