<div class="page-head">
  <div>
    <h1>Produksi Air</h1>
    <p class="muted">Catat meter induk sumur. NRW = (produksi − pemakaian terjual) ÷ produksi.</p>
  </div>
  <div class="page-actions">
    <button class="btn btn-primary" type="button" data-modal-open="modalProduksi">Catat produksi</button>
  </div>
</div>

<section class="card">
  <div class="report-grid" data-hasil="ringkas">
    <div class="report-box"><span>Total produksi</span><strong><%= angka(totalProduksi, 1) %> m³</strong></div>
    <div class="report-box"><span>Terjual (tagihan)</span><strong><%= angka(totalTerjual, 1) %> m³</strong></div>
    <div class="report-box"><span>NRW</span><strong><%= angka(totalNrw, 1) %>%</strong></div>
  </div>

  <form action="/produksi" method="get" class="filters">
    <div class="field"><label>Bulan</label><input class="input" type="month" name="bulan" value="<%= bulan %>"></div>
    <div class="field">
      <label>Sumur</label>
      <select name="sumur">
        <option value="">Semua sumur</option>
        <% sumurList.forEach((s) => { %>
          <option value="<%= s.id %>" <%= filterSumur === s.id ? 'selected' : '' %>><%= s.kode %> · <%= s.nama %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><button class="btn btn-primary" type="submit">Tampilkan</button></div>
  </form>

  <div class="table-wrap" data-hasil="daftar">
    <table class="table">
      <thead>
        <tr><th>Dusun</th><th>Sumur</th><th class="num">Pelanggan</th><th class="num">Produksi</th><th class="num">Terjual</th><th class="num">NRW</th></tr>
      </thead>
      <tbody>
        <% if (!ringkas.length) { %><tr><td colspan="6" class="empty-cell">Belum ada data sumur.</td></tr><% } %>
        <% ringkas.forEach((r) => { %>
          <tr>
            <td><%= r.dusun %></td>
            <td><strong><%= r.kode %></strong> · <%= r.nama %></td>
            <td class="num"><%= angka(r.pelanggan) %></td>
            <td class="num"><%= angka(r.produksi, 1) %> m³</td>
            <td class="num"><%= angka(r.terjual, 1) %> m³</td>
            <td class="num">
              <span class="badge <%= r.nrw > 25 ? 'badge-danger' : r.nrw > 15 ? 'badge-warning' : 'badge-success' %>"><%= angka(r.nrw, 1) %>%</span>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<dialog class="modal" id="modalProduksi">
  <div class="modal-head">
    <h2>Catat produksi harian</h2>
    <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
  </div>
  <div class="modal-body">
    <form action="/produksi" method="post">
      <div class="form-grid">
        <div class="field span-2">
          <label>Sumur</label>
          <select name="sumur_id" required>
            <% sumurList.forEach((s) => { %>
              <option value="<%= s.id %>"><%= s.kode %> · <%= s.nama %> (<%= s.dusun %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="field"><label>Tanggal</label><input class="input" type="date" name="tanggal" value="<%= today %>" required></div>
        <div class="field"><label>Jam operasi</label><input class="input" type="number" step="0.1" name="jam_operasi" placeholder="4.5"></div>
        <div class="field"><label>Meter awal (m³)</label><input class="input" type="number" step="0.01" name="meter_awal" required></div>
        <div class="field"><label>Meter akhir (m³)</label><input class="input" type="number" step="0.01" name="meter_akhir" required></div>
        <div class="field span-2"><label>Catatan</label><input class="input" name="catatan" placeholder="Opsional"></div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Simpan produksi</button>
        <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
      </div>
    </form>
  </div>
</dialog>

<section class="card" data-hasil="catatan">
  <div class="card-head"><h2>Riwayat produksi</h2><span class="muted small"><%= entries.length %> catatan</span></div>
    <div class="table-wrap" style="max-height:420px;overflow-y:auto;">
      <table class="table">
        <thead><tr><th>Tanggal</th><th>Sumur</th><th class="num">Volume</th><th class="num">Jam</th><th></th></tr></thead>
        <tbody>
          <% if (!entries.length) { %><tr><td colspan="5" class="empty-cell">Belum ada catatan pada bulan ini.</td></tr><% } %>
          <% entries.forEach((e) => { %>
            <tr>
              <td class="nowrap"><%= tanggal(e.tanggal) %></td>
              <td><%= e.kode %><div class="small muted"><%= e.dusun %></div></td>
              <td class="num"><%= angka(e.volume_m3, 1) %> m³</td>
              <td class="num"><%= e.jam_operasi || '-' %></td>
              <td class="num">
                <form action="/produksi/<%= e.id %>/hapus" method="post" data-confirm="Hapus catatan produksi ini?">
                  <button class="btn btn-ghost btn-sm" type="submit">Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
