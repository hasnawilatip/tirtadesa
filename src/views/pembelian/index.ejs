<div class="page-head">
  <div>
    <h1>Pembelian Bahan</h1>
    <p class="muted">Catat nota pembelian material; stok bertambah saat barang diterima.</p>
  </div>
  <% if (bolehKelola) { %>
    <div class="page-actions">
      <button class="btn btn-primary" type="button" data-modal-open="modalPembelian">+ Catat pembelian</button>
      <a class="btn btn-ghost" href="/bahan">Gudang bahan</a>
    </div>
  <% } else { %>
    <div class="page-actions"><a class="btn btn-ghost" href="/bahan">Gudang bahan</a></div>
  <% } %>
</div>

<% if (bolehKelola) { %>
  <dialog class="modal modal-lg" id="modalPembelian">
    <div class="modal-head">
      <div>
        <h2>Catat pembelian bahan</h2>
        <span class="muted">Nomor <strong><%= nomorOtomatis %></strong> otomatis · stok bertambah setelah barang diterima</span>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
    </div>
    <div class="modal-body">
      <%- include('form', {
        dalamModal: true,
        row: null,
        items,
        bahanList,
        metodeLabel,
        nomorOtomatis,
      }) %>
    </div>
  </dialog>
<% } %>

<div class="kpi-grid">
  <div class="card kpi kpi-blue">
    <span class="kpi-icon">🧾</span>
    <span class="kpi-label">Pembelian bulan ini</span>
    <strong class="kpi-value"><%= rupiah(ringkas.bulanTotal) %></strong>
    <span class="kpi-foot"><%= angka(ringkas.bulanNota) %> nota diterima</span>
  </div>
  <div class="card kpi kpi-amber">
    <span class="kpi-icon">✎</span>
    <span class="kpi-label">Draf belum diterima</span>
    <strong class="kpi-value"><%= angka(ringkas.draf) %></strong>
    <span class="kpi-foot">Barang belum menambah stok</span>
  </div>
  <div class="card kpi kpi-slate">
    <span class="kpi-icon">🏪</span>
    <span class="kpi-label">Supplier tercatat</span>
    <strong class="kpi-value"><%= angka(ringkas.supplier) %></strong>
    <span class="kpi-foot">Dari pembelian diterima</span>
  </div>
  <div class="card kpi kpi-red">
    <span class="kpi-icon">⚠️</span>
    <span class="kpi-label">Bahan perlu dibeli</span>
    <strong class="kpi-value"><%= angka(ringkas.menipis) %></strong>
    <span class="kpi-foot">
      <% if (bolehKelola && ringkas.menipis) { %>
        <a class="link" href="/pembelian?buka=modalPembelian&dari=menipis">Buat pembelian stok menipis</a>
      <% } else { %>Stok masih aman<% } %>
    </span>
  </div>
</div>

<section class="card">
  <form action="/pembelian" method="get" class="filters">
    <div class="field filter-cari">
      <label>Cari</label>
      <input class="input" name="q" value="<%= filters.q %>" placeholder="Nomor nota, supplier, catatan">
    </div>
    <div class="field">
      <label>Status</label>
      <select name="status">
        <option value="">Semua status</option>
        <option value="draf" <%= filters.status === 'draf' ? 'selected' : '' %>>Draf</option>
        <option value="diterima" <%= filters.status === 'diterima' ? 'selected' : '' %>>Diterima</option>
        <option value="dibatalkan" <%= filters.status === 'dibatalkan' ? 'selected' : '' %>>Dibatalkan</option>
      </select>
    </div>
    <div class="field">
      <label>Bulan</label>
      <input class="input" type="month" name="bulan" value="<%= filters.bulan %>">
    </div>
    <div class="field"><button class="btn btn-primary" type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" data-hasil="daftar">
    <table class="table">
      <thead>
        <tr>
          <th>Nomor</th>
          <th>Tanggal</th>
          <th>Supplier</th>
          <th class="col-dusun">Metode</th>
          <th class="num">Item</th>
          <th class="num">Total</th>
          <th>Status</th>
          <th class="col-aksi"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="empty-cell">Belum ada pembelian pada filter ini.</td></tr>
        <% } %>
        <% rows.forEach((p) => { %>
          <tr>
            <td>
              <a class="link" href="/pembelian/<%= p.id %>"><strong><%= p.nomor %></strong></a>
              <div class="small muted"><%= p.dibuat_oleh ? 'Dicatat admin' : '' %></div>
            </td>
            <td class="small"><%= tanggal(p.tanggal) %></td>
            <td><%= p.supplier || '—' %></td>
            <td class="col-dusun small"><%= metodeLabel[p.metode] || p.metode %></td>
            <td class="num small"><%= angka(p.jumlah_item) %> jenis</td>
            <td class="num"><strong><%= rupiah(p.total) %></strong></td>
            <td><span class="badge <%= statusKelas(p.status) %>"><%= statusLabel[p.status] || p.status %></span></td>
            <td class="num col-aksi nowrap">
              <a class="link" href="/pembelian/<%= p.id %>">Detail</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
