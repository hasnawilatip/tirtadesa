<% const badgeKelas = (s) => s === 'baru' ? 'badge-warning' : (s === 'selesai' ? 'badge-success' : 'badge-info'); %>
<div class="page-head">
  <div>
    <h1>Reset Password</h1>
    <p class="muted">Permintaan pemulihan password dari halaman <a href="/lupa-password">Lupa Password</a>. Reset password akun melalui menu Pengguna.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-ghost" href="/superadmin">← Panel superadmin</a>
    <a class="btn btn-primary" href="/pengguna">Buka menu Pengguna</a>
  </div>
</div>

<div class="tabs">
  <a class="tab <%= !filter ? 'active' : '' %>" href="/superadmin/reset-password">Semua (<%= total %>)</a>
  <% statusOptions.forEach((s) => { %>
    <a class="tab <%= filter === s ? 'active' : '' %>" href="/superadmin/reset-password?status=<%= s %>"><%= statusReset[s] %> (<%= hitung[s] %>)</a>
  <% }) %>
</div>

<% if (!rows.length) { %>
  <section class="card">
    <div class="empty"><p>Tidak ada permintaan pada filter ini.</p></div>
  </section>
<% } else { %>
  <section class="card">
    <div class="card-head"><h2>Daftar permintaan</h2><span class="muted small"><%= rows.length %> data</span></div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Waktu</th>
            <th>Username</th>
            <th>Nama</th>
            <th>Kontak</th>
            <th>Catatan</th>
            <th>Status</th>
            <th>Ubah status</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((p) => { %>
            <tr>
              <td class="small nowrap"><%= p.created_at %></td>
              <td><strong><%= p.username %></strong></td>
              <td class="small"><%= p.nama || '—' %></td>
              <td class="small">
                <% if (p.wa) { %><a href="<%= p.wa %>" target="_blank" rel="noopener"><%= p.whatsapp %></a><% } else { %><%= p.whatsapp %><% } %>
              </td>
              <td class="small"><%= p.pesan || '—' %></td>
              <td><span class="badge <%= badgeKelas(p.status) %>"><%= statusReset[p.status] %></span></td>
              <td>
                <form action="/superadmin/reset-password/<%= p.id %>/status" method="post" class="btn-row" style="margin:0;">
                  <select name="status" class="input" style="width:132px;">
                    <% statusOptions.forEach((s) => { %>
                      <option value="<%= s %>" <%= p.status === s ? 'selected' : '' %>><%= statusReset[s] %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-primary btn-sm" type="submit">Simpan</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
