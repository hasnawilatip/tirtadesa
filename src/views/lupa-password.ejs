<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b2239">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="description" content="Ajukan pemulihan password akun <%= pengaturan.nama_aplikasi %>.">
  <title>Lupa Password · <%= pengaturan.nama_aplikasi %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof versiAset !== 'undefined' ? versiAset : '' %>">
</head>
<body class="join-body">
<%- include('partials/loader') %>

<header class="home-nav">
  <div class="home-nav-inner">
    <a class="home-brand" href="/">
      <% if (pengaturan.logo_path) { %>
        <img class="brand-logo" src="<%= pengaturan.logo_path %>" alt="Logo <%= pengaturan.nama_aplikasi %>">
      <% } else { %>
        <span class="brand-mark"><%= brandInisial %></span>
      <% } %>
      <span class="brand-text">
        <strong><%= pengaturan.nama_aplikasi %></strong>
        <span><%= pengaturan.tagline %></span>
      </span>
    </a>
    <div class="home-nav-actions">
      <a class="btn btn-ghost btn-sm" href="/">← Beranda</a>
      <a class="btn btn-primary btn-sm" href="/login">Masuk</a>
    </div>
  </div>
</header>

<main class="join-main">
  <section class="join-pitch">
    <span class="hero-badge">Pemulihan Akun</span>
    <h1>Lupa password? Kami bantu pulihkan akses Anda.</h1>
    <p>Isi formulir berikut. Admin akan memverifikasi data Anda, lalu mereset password akun dan mengirimkannya melalui WhatsApp.</p>
    <ul class="join-list">
      <li>Verifikasi melalui nomor WhatsApp terdaftar</li>
      <li>Password baru diberikan langsung oleh admin</li>
      <li>Tidak ada biaya pemulihan</li>
    </ul>
    <div class="join-note">
      <span aria-hidden="true">🔒</span>
      <div>
        <strong>Demi keamanan</strong>
        Kami tidak pernah meminta password lama Anda melalui chat atau telepon.
      </div>
    </div>
  </section>

  <section class="join-card">
    <% if (sukses) { %>
      <div class="join-success">
        <div class="big-check">✓</div>
        <h2>Permintaan terkirim!</h2>
        <p>Admin akan menghubungi Anda melalui WhatsApp untuk verifikasi dan pengiriman password baru. Mohon tunggu maksimal 1×24 jam kerja.</p>
        <div class="btn-row" style="justify-content:center;">
          <a class="btn btn-primary" href="/login">Kembali ke halaman masuk</a>
        </div>
      </div>
    <% } else { %>
      <h2>Formulir pemulihan</h2>
      <p class="muted">Masukkan data yang terdaftar di aplikasi.</p>

      <% if (error) { %>
        <div class="alert alert-error" style="margin-top:16px;"><span><%= error %></span></div>
      <% } %>

      <form class="join-form" action="/lupa-password" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="username">Username *</label>
          <input class="input" id="username" name="username" value="<%= form.username || '' %>" required autocomplete="username">
        </div>
        <div class="field">
          <label for="nama">Nama lengkap (opsional)</label>
          <input class="input" id="nama" name="nama" value="<%= form.nama || '' %>" autocomplete="name">
        </div>
        <div class="field">
          <label for="whatsapp">No. WhatsApp terdaftar *</label>
          <input class="input" id="whatsapp" name="whatsapp" value="<%= form.whatsapp || '' %>" placeholder="081234567890" inputmode="tel" required>
        </div>
        <div class="field">
          <label for="pesan">Catatan (opsional)</label>
          <textarea class="input" id="pesan" name="pesan" rows="3" placeholder="Contoh: akun milik saya, lupa password sejak minggu lalu."><%= form.pesan || '' %></textarea>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary btn-block" type="submit">Kirim Permintaan</button>
        </div>
        <p class="small muted" style="margin-top:10px;text-align:center;">Sudah ingat password? <a class="link" href="/login">Masuk di sini</a></p>
      </form>
    <% } %>
  </section>
</main>

<footer class="home-foot join-foot">
  <div class="home-foot-inner">
    <span>© <%= new Date().getFullYear() %> <%= pengaturan.nama_aplikasi %> · <%= pengaturan.tagline %> · Dikembangkan oleh <strong>Hasnawi Latip</strong></span>
    <a href="/login">Masuk aplikasi</a>
  </div>
</footer>

<script src="/js/app.js?v=<%= typeof versiAset !== 'undefined' ? versiAset : '' %>"></script>
</body>
</html>
