<div class="page-head">
  <div>
    <h1>Pengguna</h1>
    <p class="muted">
      <% if (isSuperadmin) { %>
        Hanya akun <strong>superadmin</strong> dan <strong>Admin Desa</strong> yang tampil. Akun admin dusun, kasir, petugas, dan warga tidak ditampilkan di daftar utama.
      <% } else if (adminDusun) { %>
        Kelola akun petugas catat dan warga di <%= user.dusun_nama %>.
      <% } else { %>
        Kelola akun petugas catat, kasir, dan warga di lingkungan desa Anda.
      <% } %>
    </p>
  </div>
  <div class="page-actions">
    <% if (isSuperadmin) { %><a class="btn btn-ghost" href="/superadmin/pendaftaran">Lihat pendaftaran</a><% } %>
    <button class="btn btn-primary" type="button" data-modal-open="modalDaftarAkun">Daftar Akun</button>
  </div>
</div>

<% if (isSuperadmin) { %>
  <div class="btn-row" style="margin:-4px 0 16px;">
    <a class="btn btn-sm <%= tingkat === 'pengelola' ? 'btn-primary' : 'btn-ghost' %>" href="/pengguna">Superadmin &amp; Admin Desa</a>
    <a class="btn btn-sm <%= tingkat === 'dusun' ? 'btn-primary' : 'btn-ghost' %>" href="/pengguna?tingkat=dusun">Admin Dusun (<%= jumlahAdminDusun %>)</a>
    <a class="btn btn-sm <%= tingkat === 'semua' ? 'btn-primary' : 'btn-ghost' %>" href="/pengguna?tingkat=semua">Semua admin</a>
  </div>
<% } %>

<dialog class="modal" id="modalDaftarAkun">
  <div class="modal-head">
    <div>
      <h2>Daftarkan akun baru</h2>
      <span class="muted"><%= desa ? desa.nama : 'Desa' %></span>
    </div>
    <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
  </div>
  <div class="modal-body">
    <form action="/pengguna" method="post">
    <div class="form-grid">
      <div class="field"><label>Nama lengkap</label><input class="input" name="nama" required></div>
      <div class="field"><label>Username</label><input class="input" name="username" required autocomplete="off"></div>
      <div class="field"><label>Password (min. 8 karakter, huruf + angka)</label><input class="input" type="password" name="password" minlength="8" required autocomplete="new-password"></div>
      <div class="field">
        <label>Peran</label>
        <select name="role">
          <% roleOptions.forEach((r) => { %>
            <option value="<%= r %>"><%= roleLabel[r] || r %></option>
          <% }) %>
        </select>
      </div>
      <% if (adminDusun) { %>
        <div class="field">
          <label>Dusun</label>
          <input class="input" value="<%= dusunList.length ? dusunList[0].nama : '' %>" disabled>
          <input type="hidden" name="dusun_id" value="<%= dusunList.length ? dusunList[0].id : '' %>">
          <span class="small muted">Akun otomatis terhubung ke dusun Anda.</span>
        </div>
      <% } else { %>
        <div class="field">
          <label>Dusun</label>
          <select name="dusun_id">
            <option value="">— Tingkat desa —</option>
            <% dusunList.forEach((d) => { %>
              <option value="<%= d.id %>"><%= d.nama %></option>
            <% }) %>
          </select>
          <span class="small muted">
            <%= isSuperadmin ? 'Wajib untuk admin dusun.' : 'Wajib untuk petugas catat dan warga; kasir boleh tingkat desa.' %>
          </span>
        </div>
      <% } %>
      <div class="field span-2" id="fieldPelanggan" hidden>
        <label>Pelanggan (untuk akun warga)</label>
        <select name="pelanggan_id">
          <option value="">— Pilih pelanggan —</option>
          <% pelangganList.forEach((p) => { %>
            <option value="<%= p.id %>"><%= p.nomor_pelanggan %> · <%= p.nama %></option>
          <% }) %>
        </select>
        <span class="small muted">Akun warga hanya bisa melihat tagihan, pemakaian, dan mengirim keluhan untuk pelanggan ini.</span>
      </div>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Daftarkan akun</button>
      <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
    </div>
  </form>
  </div>
</dialog>

<section class="card">
  <div class="card-head">
    <h2>
      <% if (!isSuperadmin) { %>Akun staf
      <% } else if (tingkat === 'dusun') { %>Akun admin dusun
      <% } else if (tingkat === 'semua') { %>Semua akun admin
      <% } else { %>Superadmin &amp; Admin Desa<% } %>
    </h2>
    <span class="muted small"><%= rows.length %> akun</span>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Nama</th><th>Username</th><th>Peran</th><th>Dusun</th><th>Pelanggan</th><th>Status</th><th>Aksi</th></tr></thead>
      <tbody>
        <% rows.forEach((u) => { %>
          <% const bisaKelola = isSuperadmin
               ? ['superadmin', 'admin_desa', 'admin_dusun'].includes(u.role)
               : (adminDusun
                  ? (['petugas_catat', 'warga'].includes(u.role) && u.dusun_id === user.dusun_id)
                  : ['petugas_catat', 'kasir', 'warga'].includes(u.role)); %>
          <% const diriSendiri = u.id === user.id; %>
          <tr>
            <td><strong><%= u.nama %></strong></td>
            <td class="small"><%= u.username %></td>
            <td><span class="badge badge-info"><%= u.role_label || roleLabel[u.role] || u.role %></span></td>
            <td><%= u.dusun || (u.desa_jenis === 'individu' ? 'Tingkat usaha' : u.desa_jenis === 'dusun' ? 'Dusun mandiri' : 'Tingkat desa') %></td>
            <td class="small"><%= u.pelanggan_nama ? `${u.nomor_pelanggan} · ${u.pelanggan_nama}` : '—' %></td>
            <td><span class="badge <%= u.is_active ? 'badge-success' : 'badge-muted' %>"><%= u.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
            <td>
              <% if (bisaKelola || diriSendiri) { %>
                <div class="btn-row" style="margin:0;">
                  <% if (isSuperadmin && ['superadmin', 'admin_desa', 'admin_dusun'].includes(u.role)) { %>
                    <button class="link" type="button" data-modal-open="modalEdit<%= u.id %>">Edit</button>
                  <% } %>
                  <% if (bisaKelola) { %>
                    <form action="/pengguna/<%= u.id %>/toggle" method="post">
                      <button class="btn btn-ghost btn-sm" type="submit"><%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %></button>
                    </form>
                  <% } %>
                  <details>
                    <summary class="link" style="cursor:pointer;font-size:.8rem;">Reset password</summary>
                    <form action="/pengguna/<%= u.id %>/password" method="post" class="btn-row">
                      <input class="input" type="password" name="password" placeholder="Password baru (min. 8)" minlength="8" style="width:150px;">
                      <button class="btn btn-primary btn-sm" type="submit">Simpan</button>
                    </form>
                  </details>
                </div>
              <% } else { %>
                <span class="muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% if (isSuperadmin) { %>
  <% rows.filter((u) => ['superadmin', 'admin_desa', 'admin_dusun'].includes(u.role)).forEach((u) => { %>
    <% const dusunPilihan = semuaDusun.filter((d) => Number(d.desa_id) === Number(u.desa_id)); %>
    <dialog class="modal" id="modalEdit<%= u.id %>">
      <div class="modal-head">
        <div>
          <h2>Edit akun admin</h2>
          <span class="muted"><%= u.desa_nama || 'Ruang kerja' %><%= u.desa_jenis ? ` · ${u.desa_jenis}` : '' %></span>
        </div>
        <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
      </div>
      <div class="modal-body">
        <form action="/pengguna/<%= u.id %>/ubah" method="post" data-edit-akun>
          <input type="hidden" name="tingkat" value="<%= tingkat %>">
          <div class="form-grid">
            <div class="field">
              <label>Nama lengkap</label>
              <input class="input" name="nama" value="<%= u.nama %>" required>
            </div>
            <div class="field">
              <label>Username</label>
              <input class="input" name="username" value="<%= u.username %>" required>
            </div>
            <div class="field">
              <label>Peran</label>
              <select name="role">
                <option value="superadmin" <%= u.role === 'superadmin' ? 'selected' : '' %>>Superadmin</option>
                <option value="admin_desa" <%= u.role === 'admin_desa' ? 'selected' : '' %>>Admin Pengelola (desa/usaha)</option>
                <option value="admin_dusun" <%= u.role === 'admin_dusun' ? 'selected' : '' %>>Admin Dusun</option>
              </select>
            </div>
            <div class="field">
              <label>Dusun</label>
              <select name="dusun_id">
                <option value="">— Tingkat desa/pengelola —</option>
                <% dusunPilihan.forEach((d) => { %>
                  <option value="<%= d.id %>" <%= Number(u.dusun_id) === Number(d.id) ? 'selected' : '' %>><%= d.nama %></option>
                <% }) %>
              </select>
              <span class="small muted">Wajib dipilih bila peran Admin Dusun.</span>
            </div>
          </div>
          <% if (u.id === user.id) { %>
            <p class="small muted">Anda sedang mengubah akun sendiri. Peran superadmin tidak dapat diturunkan.</p>
          <% } %>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">Simpan perubahan</button>
            <button class="btn btn-ghost" type="button" data-modal-close>Batal</button>
          </div>
        </form>
      </div>
    </dialog>
  <% }) %>
<% } %>

<script>
  (() => {
    const form = document.querySelector('#modalDaftarAkun form');
    if (!form) return;
    const role = form.querySelector('[name="role"]');
    const box = document.getElementById('fieldPelanggan');
    if (!role || !box) return;
    const pilih = box.querySelector('select');
    const atur = () => {
      const warga = role.value === 'warga';
      box.hidden = !warga;
      pilih.disabled = !warga;
      pilih.required = warga;
    };
    role.addEventListener('change', atur);
    atur();
  })();

  // Pada popup edit akun, pilihan dusun hanya aktif untuk peran Admin Dusun.
  (() => {
    document.querySelectorAll('form[data-edit-akun]').forEach((form) => {
      const role = form.querySelector('[name="role"]');
      const dusun = form.querySelector('[name="dusun_id"]');
      if (!role || !dusun) return;
      const atur = () => {
        const perlu = role.value === 'admin_dusun';
        dusun.disabled = !perlu;
        dusun.required = perlu;
      };
      role.addEventListener('change', atur);
      atur();
    });
  })();
</script>
