<% const kelolaSumur = user.role === 'admin_desa' || user.role === 'admin_dusun'; %>
<div class="page-head">
  <div>
    <h1>Sumur Bor</h1>
    <p class="muted">Daftar unit sumur bor (BOS) beserta jumlah pelanggan terlayani.</p>
  </div>
  <% if (kelolaSumur) { %>
    <div class="page-actions">
      <button class="btn btn-primary" type="button" data-modal-open="modalSumur">Tambah sumur</button>
    </div>
  <% } %>
</div>

<% if (kelolaSumur) { %>
  <dialog class="modal" id="modalSumur">
    <div class="modal-head">
      <div>
        <h2>Tambah Sumur Bor</h2>
        <span class="muted">Lengkapi data unit sumur bor.</span>
      </div>
      <button class="modal-close" type="button" data-modal-close aria-label="Tutup">×</button>
    </div>
    <div class="modal-body">
      <%- include('_sumur-fields', { row: null, dusunList, modal: true }) %>
    </div>
  </dialog>
<% } %>

<section class="card">
  <form action="/sumur" method="get" class="filters">
    <div class="field"><label>Cari</label><input class="input" name="q" value="<%= filters.q %>" placeholder="Nama atau kode sumur"></div>
    <div class="field">
      <label>Dusun</label>
      <select name="dusun">
        <option value="">Semua dusun</option>
        <% dusunList.forEach((d) => { %>
          <option value="<%= d.id %>" <%= filters.dusun === d.id ? 'selected' : '' %>><%= d.nama %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><button class="btn btn-primary" type="submit">Filter</button></div>
  </form>

  <div class="table-wrap" data-hasil="daftar">
    <table class="table">
      <thead>
        <tr>
          <th>Kode</th>
          <th>Nama sumur</th>
          <th>Dusun</th>
          <th class="num">Kapasitas</th>
          <th>Meter induk</th>
          <th class="num">Pelanggan</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8" class="empty-cell">Belum ada sumur pada filter ini.</td></tr>
        <% } %>
        <% rows.forEach((s) => { %>
          <tr>
            <td><strong><%= s.kode %></strong></td>
            <td>
              <%= s.nama %>
              <div class="small muted"><%= s.alamat || '-' %></div>
            </td>
            <td><%= s.dusun %></td>
            <td class="num"><%= s.kapasitas_lps ? `${angka(s.kapasitas_lps, 1)} L/dtk` : '-' %></td>
            <td class="small"><%= s.nomor_meter_induk || '-' %></td>
            <td class="num"><%= angka(s.pelanggan) %></td>
            <td><span class="badge <%= statusKelas(s.status) %>"><%= statusLabel[s.status] %></span></td>
            <td class="num">
              <% if (kelolaSumur) { %>
                <a class="link" href="/sumur/<%= s.id %>/edit">Edit</a>
              <% } else { %>
                <span class="muted small">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
