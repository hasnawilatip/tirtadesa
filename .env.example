# Lingkungan produksi — salin menjadi `.env` lalu isi nilainya.
# Jangan pernah commit berkas `.env`.

NODE_ENV=production
PORT=3000

# Wajib. Buat dengan: openssl rand -hex 48
SESSION_SECRET=

# Akun superadmin pertama (dipakai hanya saat database masih kosong).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# 1 bila aplikasi berada di belakang reverse proxy (Nginx/Caddy) agar IP klien terbaca.
TRUST_PROXY=1

# 1 untuk mengirim cookie hanya lewat HTTPS (wajib di produksi).
COOKIE_SECURE=1

# 1 = superadmin wajib memakai autentikasi dua faktor.
WAJIB_2FA_SUPERADMIN=1

# 0 = jangan buat akun/data demo. Jangan diubah ke 1 di produksi.
SEED_DEMO=0

# Biaya bcrypt (10–14).
BCRYPT_ROUNDS=12
